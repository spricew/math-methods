---
import type { AstroComponent } from '@lucide/astro';

interface Props {
    href: string;
    Icon: AstroComponent;
    extraclass?: string;
};

const { href, Icon, extraclass } = Astro.props;
---

<a href={`/${href}`} aria-label="Ir al método" class={`flex justify-center items-center size-12 rounded-full bg-black-primary text-on-primary 
transition-transform duration-250 ease-[cubic-bezier(0.38,_0.49,_0,_1)]
cursor-pointer hover:scale-110 ${extraclass}`}>
    <Icon />
</a>