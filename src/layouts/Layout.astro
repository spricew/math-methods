---
import '@/styles/global.css';
import Navbar from '@/components/layout/Navbar.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Herramienta interactiva de análisis numérico: resuelve ecuaciones con Newton-Raphson, Bisección y Secante paso a paso.' } =
	Astro.props;

const tituloCompleto = title === 'MathMethods' ? title : `${title} · MathMethods`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{tituloCompleto}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={tituloCompleto} />
		<meta property="og:description" content={description} />
	</head>
	<body class="grid grid-rows-[auto_1fr]">
		<Navbar />
		<slot />
	</body>
</html>
