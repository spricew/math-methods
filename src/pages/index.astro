---
import Layout from '@/layouts/Layout.astro';
import Card from '@/components/ui/Card.astro'

import { METHODS, type MethodId } from '@/data/methods';
import { TrendingDown, ChevronsDownUp, LineDotRightHorizontal } from '@lucide/astro'

type Variant = 'primary' | 'secondary' | 'tertiary';

interface Presentacion {
	Icon: typeof TrendingDown;
	variant: Variant;
}

const presentacion: Record<MethodId, Presentacion> = {
	'newton-raphson': { Icon: TrendingDown, variant: 'primary' },
	bisection: { Icon: ChevronsDownUp, variant: 'secondary' },
	secant: { Icon: LineDotRightHorizontal, variant: 'tertiary' }
};

const operaciones = METHODS.map((metodo) => ({ ...metodo, ...presentacion[metodo.id] }));
---

<Layout title='MathMethods'>

	<main class="flex flex-col justify-center gap-8 w-full px-6 md:px-12 lg:px-24 py-8">
		<header class="flex flex-col">
			<span class="text-sm tracking-wider font-bold text-primary">ANÁLISIS NUMÉRICO</span>
			<h1 class="mb-2 text-3xl md:text-4xl tracking-tighter font-semibold">Métodos de búsqueda de raíces</h1>
			<p class="text-lg">Selecciona un método numérico para resolver ecuaciones</p>
		</header>

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

			{operaciones.map((operacion) => (
				<Card
					slug={operacion.slug}
					title={operacion.titulo}
					description={operacion.descripcion}
					Icon={operacion.Icon}
					variant={operacion.variant}
				/>
			))}

		</div>
	</main>
</Layout>
