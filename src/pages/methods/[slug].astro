---
import Layout from "@/layouts/Layout.astro";
import Input from "@/components/ui/Input.astro";
import Button from "@/components/ui/Button.astro";
import { METHODS, type Metodo } from "@/data/methods";

export function getStaticPaths() {
    return METHODS.map((metodo) => ({ params: { slug: metodo.slug }, props: { metodo } }));
}

interface Props {
    metodo: Metodo;
}

const { metodo } = Astro.props;
---

<Layout title={`Método de ${metodo.titulo}`}>
    <main class="grid grid-cols-2 h-full gap-8 px-24 py-8">
        
        <section class="flex flex-col gap-6">
            <header class="flex flex-col gap-1">
                <h1 class="text-3xl tracking-tight font-semibold">Parámetros</h1>
                <p class="text-slate-500">Resuelve ecuaciones con el método de {metodo.titulo}</p>
            </header>

            <form id="formulario-metodo" data-method={metodo.slug} class="flex flex-col gap-4">
                
                <Input label="Función f(x)" type="text" placeholder="ej. x^3 - 2*x + 1" name="funcion" required />
                
                <div class="grid grid-cols-2 gap-4">
                    <Input label="Tolerancia (Error)" type="number" step="any" min="0" placeholder="ej. 0.001" name="tolerancia" required />
                    <Input label="Max. Iteraciones" type="number" min="1" placeholder="ej. 50" name="iteraciones" value="50" required />
                </div>

                {metodo.campos.length > 0 && (
                    <div class="grid grid-cols-2 gap-4">
                        {metodo.campos.map((campo) => (
                            <div class={campo.ancho === 'completo' ? 'col-span-2' : ''}>
                                <Input
                                    label={campo.label}
                                    type={campo.tipo ?? 'number'}
                                    step={campo.paso}
                                    placeholder={campo.placeholder}
                                    name={campo.nombre}
                                    required={campo.requerido === true}
                                />
                            </div>
                        ))}
                    </div>
                )}

                <p
                    id="error-formulario"
                    role="alert"
                    hidden
                    class="p-4 rounded-2xl bg-error-container text-on-error-container text-sm leading-relaxed"
                >
                </p>

                <div class="flex gap-2 mt-4">
                    <Button type="submit" text="Calcular" variant="primary" extraclass="flex-1" shadow/>
                    <Button type="reset" text="Limpiar" variant="danger"/>
                </div>
            </form>
        </section>

        <section class="flex flex-col gap-8 rounded-3xl p-8 bg-surface-container-lowest ring ring-outline-variant/50">
            <header class="flex flex-col gap-4">
                <h1 class="text-xl tracking-tight font-medium">Resultado</h1>
                <div class="flex flex-col p-6 rounded-2xl bg-primary-background border border-primary/20" aria-live="polite">
                    <span class="text-primary font-medium mb-1">Raíz aproximada</span>
                    <span id="resultado-raiz" class="text-4xl font-semibold text-primary-container">--</span>
                    <span id="resultado-status" role="status" class="text-sm text-slate-500 mt-2 min-h-5"></span>
                </div>
            </header>

            <div class="flex flex-col gap-4">
                <h2 class="text-xl tracking-tight font-semibold">Proceso paso por paso</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 text-slate-500">
                                <th class="pb-2 font-medium">Iteración</th>
                                <th class="pb-2 font-medium">x</th>
                                <th class="pb-2 font-medium">f(x)</th>
                                <th class="pb-2 font-medium">Error (%)</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-iteraciones" class="text-sm">
                            <tr>
                                <td colspan="4" class="py-4 text-center text-slate-400">
                                    Ingresa los datos y presiona calcular para ver el procedimiento.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>
</Layout>

<script>
    import { METHODS } from '@/data/methods';
    import { ErrorDeMetodo, type Iteracion, type ResultadoMetodo } from '@/lib/numerical/types';
    import { crearFuncionSegura, leerNumero } from '@/lib/numerical/evaluacion';
    import { biseccion } from '@/lib/numerical/biseccion';
    import { newtonRaphson } from '@/lib/numerical/newton';
    import { secante } from '@/lib/numerical/secante';

    const form = document.getElementById('formulario-metodo') as HTMLFormElement | null;
    const resultadoSpan = document.getElementById('resultado-raiz');
    const resultadoStatus = document.getElementById('resultado-status');
    const tablaBody = document.getElementById('tabla-iteraciones');

    const formatoError = (error: number | null): string => {
        if (error === null) return '-';
        if (!Number.isFinite(error)) return '∞';
        return error.toFixed(4) + '%';
    };

    if (form) {
        // El slug viaja en el DOM pero se valida contra el registro tipado de métodos
        const metodoDef = METHODS.find((m) => m.slug === form.dataset.method);

        if (!metodoDef) {
            console.error(`Método desconocido: ${form.dataset.method}`);
        } else {
            const errorBox = document.getElementById('error-formulario');
            const botonCalcular = form.querySelector<HTMLButtonElement>('button[type="submit"]');
            const textoBoton = botonCalcular?.textContent ?? 'Calcular';
            const tablaPlaceholder = tablaBody?.innerHTML ?? '';

            let camposInvalidos: HTMLElement[] = [];

            const limpiarError = () => {
                for (const campo of camposInvalidos) campo.removeAttribute('aria-invalid');
                camposInvalidos = [];
                if (errorBox) errorBox.hidden = true;
            };

            // Muestra el mensaje en la caja del formulario y marca los campos responsables
            const mostrarError = (mensaje: string, campos: string[] = []) => {
                for (const nombre of campos) {
                    const campo = form.elements.namedItem(nombre);
                    if (campo instanceof HTMLElement) {
                        campo.setAttribute('aria-invalid', 'true');
                        camposInvalidos.push(campo);
                    }
                }
                if (errorBox) {
                    errorBox.textContent = mensaje;
                    errorBox.hidden = false;
                }
            };

            const establecerCargando = (cargando: boolean) => {
                if (!botonCalcular) return;
                botonCalcular.disabled = cargando;
                botonCalcular.textContent = cargando ? 'Calculando…' : textoBoton;
            };

            // El botón "Limpiar" también restaura la zona de resultados y los errores
            form.addEventListener('reset', () => {
                limpiarError();
                establecerCargando(false);
                if (resultadoSpan) resultadoSpan.textContent = '--';
                if (resultadoStatus) resultadoStatus.textContent = '';
                if (tablaBody) tablaBody.innerHTML = tablaPlaceholder;
            });

            form.addEventListener('submit', (e) => {
                e.preventDefault();
                limpiarError();

                const datos = new FormData(form);
                const tol = parseFloat(datos.get('tolerancia') as string);
                const maxIter = parseInt(datos.get('iteraciones') as string);
                let datosValidos = true;

                if (!Number.isFinite(tol) || tol <= 0) {
                    mostrarError('La tolerancia debe ser un número mayor que cero.', ['tolerancia']);
                    datosValidos = false;
                }
                if (!Number.isInteger(maxIter) || maxIter < 1) {
                    mostrarError('El máximo de iteraciones debe ser un entero mayor o igual a 1.', ['iteraciones']);
                    datosValidos = false;
                }
                if (!datosValidos) return;

                establecerCargando(true);
                // pequeña pausa para que el navegador pinte el estado de carga antes del cálculo
                new Promise((resuelto) => setTimeout(resuelto, 30))
                    .then(() => calcular(metodoDef.id, datos, tol, maxIter))
                    .finally(() => establecerCargando(false));
            });

            async function calcular(metodo: Metodo['id'], datos: FormData, tolerancia: number, maxIteraciones: number) {
                try {
                    // Carga diferida: mathjs (~500 kB) solo se descarga al primer cálculo
                    const { compile, derivative } = await import('mathjs');

                    const funcStr = datos.get('funcion') as string;

                    let funcCompilada;
                    try {
                        funcCompilada = compile(funcStr);
                    } catch {
                        mostrarError(
                            "Error de sintaxis en la función f(x). Asegúrate de usar operadores válidos (ej. 2*x en lugar de 2x).",
                            ['funcion']
                        );
                        return;
                    }
                    const f = crearFuncionSegura((x) => funcCompilada.evaluate({ x }));

                    let resultado: ResultadoMetodo;
                    try {
                        switch (metodo) {
                            case 'bisection':
                                resultado = biseccion(f, {
                                    a: leerNumero(datos, 'a', 'El límite inferior (a)'),
                                    b: leerNumero(datos, 'b', 'El límite superior (b)'),
                                    tolerancia,
                                    maxIteraciones
                                });
                                break;

                            case 'newton-raphson': {
                                const x0 = leerNumero(datos, 'x0', 'El valor inicial (x0)');
                                const derivStr = (datos.get('derivada') as string).trim();

                                // Si el usuario no escribió la derivada, mathjs la calcula automáticamente
                                let df;
                                try {
                                    df = derivStr
                                        ? crearFuncionSegura((x) => compile(derivStr).evaluate({ x }))
                                        : crearFuncionSegura((x) => derivative(funcStr, 'x').evaluate({ x }));
                                } catch {
                                    mostrarError(
                                        "Error de sintaxis en la derivada f'(x). Asegúrate de usar operadores válidos (ej. 3*x^2 en lugar de 3x²).",
                                        ['derivada']
                                    );
                                    return;
                                }

                                resultado = newtonRaphson(f, df, { x0, tolerancia, maxIteraciones });
                                break;
                            }

                            case 'secant':
                                resultado = secante(f, {
                                    x0: leerNumero(datos, 'x0', 'El valor inicial 1 (x0)'),
                                    x1: leerNumero(datos, 'x1', 'El valor inicial 2 (x1)'),
                                    tolerancia,
                                    maxIteraciones
                                });
                                break;

                            default:
                                return;
                        }
                    } catch (error) {
                        if (error instanceof ErrorDeMetodo) {
                            mostrarError(error.message, error.campos);
                        } else {
                            mostrarError(error instanceof Error ? error.message : String(error));
                        }
                        return;
                    }

                    if (resultadoSpan) resultadoSpan.textContent = resultado.raiz.toFixed(6);
                    if (resultadoStatus) {
                        resultadoStatus.textContent = resultado.convergio
                            ? `Convergió en ${resultado.iteraciones.length} iteración(es).`
                            : `No convergió en ${maxIteraciones} iteraciones. Este valor es solo la última aproximación.`;
                    }

                    renderizarTabla(resultado.iteraciones, tolerancia);
                } catch (error) {
                    mostrarError(error instanceof Error ? error.message : String(error));
                }
            }

            function renderizarTabla(iteraciones: Iteracion[], tolerancia: number) {
                if (!tablaBody) return;

                tablaBody.replaceChildren();
                for (const it of iteraciones) {
                    const tr = document.createElement('tr');
                    tr.className = 'border-b border-slate-100 hover:bg-slate-50 transition-colors';

                    const celdas: Array<[string, string]> = [
                        ['py-3 px-2', String(it.iter)],
                        ['py-3 px-2 font-mono', it.x.toFixed(6)],
                        ['py-3 px-2 font-mono text-slate-500', it.fx.toExponential(4)],
                        [
                            `py-3 px-2 font-mono${it.error !== null && it.error < tolerancia ? ' text-green-600 font-bold' : ''}`,
                            formatoError(it.error)
                        ]
                    ];

                    for (const [clases, texto] of celdas) {
                        const td = document.createElement('td');
                        td.className = clases;
                        td.textContent = texto;
                        tr.appendChild(td);
                    }
                    tablaBody.appendChild(tr);
                }
            }
        }
    }
</script>
